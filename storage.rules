rules_version = '2';

// Règles Storage pour MbokaTech.
// À coller dans la console Firebase : Storage > Règles > Publier.
service firebase.storage {
  match /b/{bucket}/o {
    match /chat-files/{meetingId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /audio-recordings/{meetingId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
